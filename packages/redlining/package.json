{
  "name": "redlining",
  "version": "0.7.8",
  "description": "Figma-style comments on your running app, exported as a file-anchored spec for your coding agent (Claude Code first; built for Next.js, runs on any page).",
  "keywords": [
    "nextjs",
    "vite",
    "react",
    "claude-code",
    "annotations",
    "dev-tools"
  ],
  "license": "MIT",
  "homepage": "https://redlining.deep-thought.rocks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deep-thought-rocks/26-redlining.git"
  },
  "bugs": "https://github.com/deep-thought-rocks/26-redlining/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "redlining": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "production": "./dist/index.prod.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      },
      "default": "./dist/next.mjs"
    },
    "./next/route": {
      "types": "./dist/next/route.d.mts",
      "import": "./dist/next/route.mjs",
      "default": "./dist/next/route.mjs"
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.mts",
        "default": "./dist/loader.mjs"
      },
      "require": {
        "types": "./dist/loader.d.cts",
        "default": "./dist/loader.cjs"
      },
      "default": "./dist/loader.mjs"
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.mts",
        "default": "./dist/vite.mjs"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      },
      "default": "./dist/vite.mjs"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js",
      "default": "./dist/standalone.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vendor-tokens": "node scripts/vendor-tokens.mjs",
    "prepublishOnly": "node scripts/check-version.mjs && pnpm build && cp ../../README.md ../../LICENSE .",
    "postpublish": "rm -f README.md LICENSE",
    "check-version": "node scripts/check-version.mjs"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.41.0"
  },
  "devDependencies": {
    "@babel/types": "^8.0.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "magic-string": "^1.2.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
