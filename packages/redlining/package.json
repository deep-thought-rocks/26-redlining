{
  "name": "redlining",
  "type": "module",
  "version": "0.0.0",
  "description": "Figma-style comments on your running Next.js app, exported as a file-anchored spec for Claude Code.",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "redlining": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      },
      "default": "./dist/next.mjs"
    },
    "./next/route": {
      "types": "./dist/next/route.d.mts",
      "import": "./dist/next/route.mjs",
      "default": "./dist/next/route.mjs"
    },
    "./loader": {
      "import": {
        "types": "./dist/loader.d.mts",
        "default": "./dist/loader.mjs"
      },
      "require": {
        "types": "./dist/loader.d.cts",
        "default": "./dist/loader.cjs"
      },
      "default": "./dist/loader.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "devDependencies": {
    "@babel/types": "^8.0.4",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.0.1",
    "magic-string": "^1.2.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "lucide-react": "^1.41.0"
  }
}
